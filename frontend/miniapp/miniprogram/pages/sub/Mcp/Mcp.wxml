
<view class="BasePage" data-theme="{{theme}}">
  <navigation-bar
    title="{{_i18n['mcp.title'] || ''}}"
    back
  ></navigation-bar>

  <scroll-view
    class="scrollarea"
    scroll-y
    type="list"
    enhanced
    scroll-anchoring
  >
    <view class="scrollarea-main">
      <view class="tips">
        <view class="tips-title">{{_i18n['mcp.aiMemoryArchive']}}</view>
        <view class="tips-desc">{{_i18n['mcp.desc']}}</view>
      </view>

      <view wx:if="{{!apiKey && !mcpConfigText && !loading}}" class="empty-state">
        <view class="empty-text">{{_i18n['mcp.noKey']}}</view>
        <view class="empty-sub">{{_i18n['mcp.noKeySub']}}</view>
        <view class="generate-btn" bindtap="generateKey">{{_i18n['mcp.generateKey']}}</view>
      </view>

      <view wx:if="{{apiKey || mcpConfigText}}" class="info-card">
        <view class="card-header">
          <view class="card-title">
            <text class="step-badge">1</text>
            <text>{{_i18n['mcp.step1Title']}}</text>
          </view>
          <view class="refresh-icon" bindtap="refreshKey">
            <text class="refresh-symbol">⟳</text>
          </view>
        </view>

        <view class="key-value" bindtap="onKeyTap">
          <text class="key-text" user-select>{{apiKey}}</text>
          <view class="copy-chip">{{_i18n['mcp.copy']}}</view>
        </view>

        <view class="tip-list key-tip" wx:if="{{!apiKey}}">
          <view class="tip-item">{{_i18n['mcp.mcpRegenerateTip']}}</view>
        </view>
      </view>

      <view wx:if="{{apiKey || mcpConfigText}}" class="info-card">
        <view class="card-header">
          <view class="card-title">
            <text class="step-badge">2</text>
            <text>{{_i18n['mcp.step2Title']}}</text>
          </view>
        </view>

        <view class="tab-bar">
          <view class="tab-item {{activeTab === 'mcp' ? 'active' : ''}}" data-tab="mcp" bindtap="switchTab">{{_i18n['mcp.tabMcp']}}</view>
          <view wx:if="{{authUrl}}" class="tab-item {{activeTab === 'connector' ? 'active' : ''}}" data-tab="connector" bindtap="switchTab">{{_i18n['mcp.tabConnector']}}</view>
          <view class="tab-item {{activeTab === 'http' ? 'active' : ''}}" data-tab="http" bindtap="switchTab">{{_i18n['mcp.tabHttp']}}</view>
        </view>

        <view class="tab-content" wx:if="{{activeTab === 'mcp'}}">
          <view class="tab-desc">{{_i18n['mcp.mcpTabDesc']}}</view>
          <view class="tip-code mcp-config-code">
            <text user-select>{{mcpConfigText}}</text>
          </view>
          <view class="copy-config-btn" bindtap="onCopyConfig">{{_i18n['mcp.copyConfig']}}</view>
        </view>

        <view class="tab-content" wx:if="{{activeTab === 'connector' && authUrl}}">
          <view class="tab-desc">{{_i18n['mcp.connectorTabDesc']}}</view>
          <view class="step-list">
            <view class="step-item">{{_i18n['mcp.connectorStep1']}}</view>
            <view class="step-item">{{_i18n['mcp.connectorStep2']}}</view>
            <view class="step-item">{{_i18n['mcp.connectorStep3']}}</view>
          </view>
          <view class="tip-code">
            <text user-select>{{authUrl}}</text>
          </view>
          <view class="copy-config-btn" bindtap="onCopyAuthUrl">{{_i18n['mcp.copyLink']}}</view>
        </view>

        <view class="tab-content" wx:if="{{activeTab === 'http'}}">
          <view class="tab-desc">{{_i18n['mcp.httpTabDesc']}}</view>

          <view class="section-title">{{_i18n['mcp.writeMemory']}}</view>
          <view class="tip-code" user-select>
POST {{memoryUrl}}
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "record_time": "2024-12-25T12:00:00Z",
  "title": "{{_i18n['mcp.inputExampleTitle']}}",
  "content": "{{_i18n['mcp.inputExampleContent']}}"
}
          </view>
          <view class="tip-list">
            <view class="tip-item">{{_i18n['mcp.tipRecordTime']}}</view>
            <view class="tip-item">{{_i18n['mcp.tipTitle']}}</view>
            <view class="tip-item">{{_i18n['mcp.tipContent']}}</view>
          </view>

          <view class="section-title http-section-gap">{{_i18n['mcp.queryMemory']}}</view>
          <view class="tip-code" user-select>
GET {{apiUrl}}?start_date=2024-01-01&end_date=2024-12-31
Authorization: Bearer {{apiKey}}
          </view>
          <view class="tip-list">
            <view class="tip-item">{{_i18n['mcp.queryDefaultRange']}}</view>
            <view class="tip-item">{{_i18n['mcp.queryDateRange']}}</view>
            <view class="tip-item">{{_i18n['mcp.queryLimit']}}</view>
            <view class="tip-item">{{_i18n['mcp.queryResultOrder']}}</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <ConfirmDialog
    visible="{{confirmDialog.visible}}"
    title="{{confirmDialog.title || ''}}"
    content="{{confirmDialog.content || ''}}"
    cancelText="{{confirmDialog.cancelText || ''}}"
    confirmText="{{confirmDialog.confirmText || ''}}"
    confirmType="{{confirmDialog.confirmType}}"
    bind:cancel="onConfirmDialogCancel"
    bind:confirm="onConfirmDialogConfirm"
    bind:close="onConfirmDialogCancel"
  />
</view>
