







DB_USER=papafeiji

DB_PASSWORD=
DB_NAME=papafeiji

# 数据库连接池（可选）：API 请求池上限/下限、后台任务池上限/下限。
# 默认 50/10/10/2；两池上限参与 scripts/check-conn-budget.sh 的连接预算校验（2×(MAX+BG_MAX) ≤ 170）。
DB_MAX_CONNS=50
DB_MIN_CONNS=10
DB_BG_MAX_CONNS=10
DB_BG_MIN_CONNS=2







REDIS_ADDR=redis:6379


REDIS_PASSWORD=

# Redis 连接池大小（可选，默认 50）
REDIS_POOL_SIZE=50




HTTP_BIND=0.0.0.0
HTTP_PORT=8080
SSE_BIND=0.0.0.0
SSE_PORT=8081
# SSE 全局并发连接上限（单用户并发固定 2）
SSE_MAX_CONNS=200





WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

WECHAT_MP_APPID=your-wechat-mp-appid
WECHAT_MP_SECRET=your-wechat-mp-secret
WECHAT_MP_GHID=your-wechat-mp-ghid

# 服务号跳转小程序的版本：release（正式版）、trial（体验版）、developer（开发版）
WECHAT_MINI_LINK_ENV_VERSION=release


WECHAT_VIRTUAL_OFFER_ID=wx_product_month_id
WECHAT_VIRTUAL_APP_KEY_PRODUCTION=your-production-app-key
WECHAT_VIRTUAL_APP_KEY_SANDBOX=your-sandbox-app-key

# 虚拟支付发货回调（安全模式）验签 Token 与 43 位 EncodingAESKey。
# SaaS 模式必填（缺一后端启动即失败），需与微信后台「虚拟支付回调」配置一致。
WECHAT_VIRTUAL_CALLBACK_TOKEN=your-virtual-callback-token
WECHAT_VIRTUAL_CALLBACK_AES_KEY=your-43-char-aes-key

# 是否允许客户端请求虚拟支付沙箱（env=1）：1=允许，留空/0=禁止。仅联调环境设为 1，生产必须关闭。
PAYMENT_ALLOW_SANDBOX=



WECHAT_MSG_TOKEN=your-msg-push-token

WECHAT_ENCODING_AES_KEY=your-encoding-aes-key


# 多端应用（Donut App）微信登录：多端应用 AppID/Secret（Donut 控制台应用详情页获取；
# 注意不是小程序、也不是移动应用的凭据）。未配置时 App 内 /auth/login/app 返回 500。
DONUT_APPID=
DONUT_APPSECRET=

TENCENT_MAP_KEY=your-tencent-map-key


AI_API_KEY=your-ai-api-key


# Cloudflare Worker 中转 API 请求的共享密钥。
# SaaS 部署时填写 SaaS 官方 Worker 密钥；开源版部署必须留空，否则 Worker 转发请求会被源站 403。
WORKER_SECRET=

# Cloudflare Worker 调用 /internal/mcp/* 的共享密钥（SaaS 必填——未配置启动即失败，
# 由 deploy.sh 渲染注入；开源版留空，后端不注册 internal/mcp 路由）
# 生成：openssl rand -hex 32
MCP_WORKER_SECRET=

# MCP 客户端公开入口（Cloudflare Worker 地址，可选，未配置时回退源站 API_HOST）
# 配置后小程序展示的 mcpConfig/apiUrl 均指向该入口，并返回绑定页 authUrl
MCP_PUBLIC_URL=




API_HOST=https://your-domain.com




OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

OSS_BUCKET=your-bucket-name
OSS_REGION=cn-hangzhou

OSS_PUBLIC_URL=

# 文件对外访问基址（可选）：OSS 四件套未配置的本地存储部署必填（files 表 URL 按它拼接，
# 空值时文件接口显式报错 storage base url not configured）；OSS 部署由 OSS_PUBLIC_URL 承担，本项留空。
STORAGE_PUBLIC_BASE_URL=




LOG_LEVEL=INFO

# 结构化日志落盘路径（可选）：非空时日志同时写该文件（需为容器挂载的持久化目录），
# stdout 仍保留；容器重建后宿主机日志不丢。本地开发留空。
LOG_FILE=

# 用户图片存储上限（字节）。0 表示不限制。
# 普通用户默认 1GB，VIP 用户默认 5GB。
USER_IMAGE_STORAGE_LIMIT_BYTES=1073741824
USER_IMAGE_STORAGE_LIMIT_BYTES_VIP=5368709120

# 已删对象边缘缓存批量收敛（ADR-0013，可选；开启需为 OSS AccessKey 授予 CDN 刷新权限）
CDN_REFRESH_ENABLED=false
JOB_INTERVAL_PURGE_DELETED_OBJECTS=24h


# 可信代理 CIDR，用于从 X-Forwarded-For 解析真实客户端 IP。
# 开源版必须设置：docker-compose 部署时前端有 nginx，需包含 nginx 所在网段，
# 否则 IP 限流会把全站所有请求当作同一来源（共享一个限流桶）。
TRUSTED_PROXY_CIDR=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.0/8

# ─── 开源版专用（SaaS 部署忽略） ───
# 部署模式：saas 或 open，默认 saas。根目录 docker-compose.yml 已为 app 硬编码
# DEPLOYMENT_MODE=open，compose 部署无需设置；仅手动运行二进制时才需设为 open。
DEPLOYMENT_MODE=

# 开源版与 Cloudflare Worker 之间的共享密钥，init.sh 自动生成
OPEN_API_KEY=

# AI 运行时配置（配置全部来自环境变量，原数据库 sys_configs 表已删除，见 ADR-0006）
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# 其余 AI/任务/开关类可选变量（默认值见 backend/internal/config/config.go、defaults.go 与 DEPLOYMENT §2）：
# AI_MAX_OUTPUT_TOKENS=、AI_THINKING_TYPE=、AI_PROMPT=、WECHAT_MP_PROMPT=、
# MCP_ENABLED=true、FREE_VIP_ENABLED=true、
# DEFAULT_COVER_IMAGE=、DEFAULT_AVATAR_URL=、DEFAULT_TRAJECTORY_ICON=、
# JOB_INTERVAL_ORDER_CLOSE=1m、JOB_INTERVAL_ABNORMAL_ALERT=5m、JOB_INTERVAL_AUTO_RECORD=5m、
# JOB_INTERVAL_CLEANUP_TRAJECTORIES=6h、JOB_INTERVAL_CLEANUP_AI_LOGS=24h、
# JOB_INTERVAL_CLEANUP_CLIENT_OPS_LOGS=24h、JOB_INTERVAL_CLEANUP_ORPHAN_FILES=168h、
# JOB_INTERVAL_CLEANUP_ORPHAN_TRAJ_MAPS=168h（常用地址汇总任务固定每日 03:00，无独立环境变量）
# （SaaS 侧以上变量由 deploy.sh 按文档口径渲染，无需手工配置）

# Cloudflare Tunnel Token（由 install.sh 自动配置，可选）
CLOUDFLARE_TUNNEL_TOKEN=

# Nginx 对外 HTTP 端口（开源版 Docker Compose 部署，默认 80）。
# 使用 Caddy 自动证书（Caddy 需独占 80/443）或本机 80 端口被占用时，需改为其他端口（如 8080），
# 对应根目录 docker-compose.yml 中 nginx 服务的端口映射 "${NGINX_HTTP_PORT:-80}:80"。
NGINX_HTTP_PORT=80

# 备份侧车（SaaS 与开源版通用）：保留份数与备份间隔（秒）。
# 默认 48 份 / 3600 秒（1 小时，每小时一份滚动保留两天）；如需更高 RPO 可调小间隔。
BACKUP_KEEP=48
BACKUP_INTERVAL=3600
